# ==============================================================================
# COSTUME STORE — PRODUCTION ENVIRONMENT CONFIGURATION (VERCEL + NEON)
# Copy this file to .env for local online-copy development or configure
# these exact variable names in your Vercel Project Settings (Settings -> Environment Variables).
# NEVER commit real credentials, production secret keys, or database passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE FLASK & SECURITY
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OTP_SECRET_KEY=

FLASK_ENV=production
DEBUG=False

SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE
# Obtain from Neon Console (https://console.neon.tech/ -> Connection Details).
# Both direct and pooled (-pooler) connections are supported.
# Example: postgresql://neondb_owner:YourPassword@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. PRIMARY STORE ADMINISTRATOR
# Automatically provisioned on startup if configured with non-empty credentials.
# Password requires >= 8 characters with uppercase, lowercase, digit, and symbol.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY
# Kept strictly in Test Mode by default.
# ------------------------------------------------------------------------------
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. PERSISTENT CLOUD MEDIA STORAGE (RECOMMENDED FOR VERCEL)
# Because Vercel functions have an ephemeral read-only filesystem, configure
# S3-compatible cloud storage (AWS S3, Cloudflare R2, Wasabi, or Supabase Storage)
# for administrative product image uploads.
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_URL_PREFIX=

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_ENABLED=False
MAIL_ADMIN_NOTIFICATION_EMAIL=
