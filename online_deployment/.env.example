# ==============================================================================
# COSTUME STORE — PRODUCTION / ONLINE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env on your local development machine or configure
# these exact variable names in your production hosting dashboard (e.g. Render).
# NEVER commit real credentials, production secret keys, or database passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE FLASK & SECURITY
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OTP_SECRET_KEY=

FLASK_ENV=production
DEBUG=False

SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL IN PRODUCTION)
# ------------------------------------------------------------------------------
# Example: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. PRIMARY STORE ADMINISTRATOR
# Automatically provisioned on first startup if configured with non-empty credentials.
# Password requires >= 8 characters with uppercase, lowercase, digit, and symbol.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. SMTP / TRANSACTIONAL EMAIL (OPTIONAL / MOCKED IN DEV)
# ------------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_ENABLED=False
MAIL_ADMIN_NOTIFICATION_EMAIL=

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY
# Set RAZORPAY_MODE=live only when activated in your Razorpay Dashboard.
# ------------------------------------------------------------------------------
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. PERSISTENT CLOUD MEDIA STORAGE (OPTIONAL)
# When STORAGE_BACKEND=s3, product uploads are persisted to S3/R2 object storage.
# Defaults to 'local' for local development filesystem.
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_URL_PREFIX=
